.github
.git
*.md
.vscode
.gitignore
Makefile
docs
.eslintcache
.gocache
/web/node_modules
/web/dist
!THIRD-PARTY-LICENSES.md
!UPSTREAM.md

# Backend API documentation needs both Go sources and embedded Markdown.
!docs/platform-api/
!docs/platform-api/*.go
!docs/platform-api/*.md

# Administrator documentation is embedded only in the backend binary.
!docs/admin-manual/
!docs/admin-manual/*.go
!docs/admin-manual/*.md
